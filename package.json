{
  "name": "mstore",
  "version": "0.3.0",
  "description": "Single-file local data store for Node: segment table + CRC + group commit, zero dependencies, TypeScript source run directly by Node.",
  "type": "module",
  "bin": {
    "mstore": "./cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "cli.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/bitmap.test.ts test/pagetable.test.ts test/biz.test.ts test/core.test.ts test/snapshot.test.ts test/predicate.test.ts test/protocol.test.ts test/store.test.ts test/keydir.test.ts",
    "mutate": "node tools/mutate.ts --target src/bitmap.ts --tests test/bitmap.test.ts",
    "mutate:index": "node tools/mutate.ts --target src/bizindex.ts --tests test/biz.test.ts,test/predicate.test.ts",
    "mutate:page": "node tools/mutate.ts --target src/pagetable.ts --tests test/pagetable.test.ts",
    "mutate:store": "node tools/mutate.ts --target src/store.ts --tests test/core.test.ts,test/biz.test.ts,test/snapshot.test.ts,test/keydir.test.ts,test/store.test.ts",
    "mutate:keys": "node tools/mutate.ts --target src/keydir.ts --tests test/keydir.test.ts,test/biz.test.ts,test/snapshot.test.ts",
    "mutate:all": "npm run mutate && npm run mutate:index && npm run mutate:page && npm run mutate:snap && npm run mutate:keys && npm run mutate:store",
    "gen": "node bench/gen.ts",
    "bench": "node bench/bench.ts",
    "demo": "node bench/demo.ts",
    "mutate:snap": "node tools/mutate.ts --target src/snapshot.ts --tests test/snapshot.test.ts",
    "bench:open": "node bench/open.ts",
    "bench:predicate": "node --expose-gc bench/predicate.ts",
    "bench:scale": "node --expose-gc bench/scale.ts"
  },
  "keywords": [
    "storage",
    "embedded",
    "single-file",
    "group-commit",
    "local-first",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
